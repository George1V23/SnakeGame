#for assigning random color to the brush
#: import rnd random
#: import UI_SCALE scale.UI_SCALE
#: import field_size scale.field_size

# Drawing pad / Graphics creation
<Graphics>:
    canvas:
        Color:
            rgb: .2, .5, .5
        Rectangle:
            size: root.size
            pos: root.pos

# Square widget coding
<Square>:
    size_hint: None, None
    size: 20 * UI_SCALE, 20 * UI_SCALE
    canvas:
        Color:
            rgb: root.color
        # bulge only enlarges the drawing (swallow animation, walls); collision keeps self.size
        Rectangle:
            size: self.width + 2 * root.bulge, self.height + 2 * root.bulge
            pos: self.x - root.bulge, self.y - root.bulge

    # Thin red line around the exact square edges used by collision logic.
    canvas.after:
        Color:
            rgba: 1, 0, 0, 1 if root.show_collision_margin else 0
        Line:
            width: UI_SCALE
            rectangle: self.x, self.y, self.width, self.height

# Triangle widget coding
<Triangle>:
    angle: 0
    color: [rnd.random(), rnd.random(), rnd.random()]
    size_hint: None, None
    size: 30 * UI_SCALE, 30 * UI_SCALE
    canvas:
        # 1. Primary instance
        PushMatrix
        Translate:
            xy: self.x, self.y
        Rotate:
            angle: root.angle
            origin: self.width / 2, self.height / 2
        Color:
            rgb: root.color
        Triangle:
            points: (0, 0, self.width, 0, self.width / 2, self.height)
        Color:
            rgb: 1, rnd.random()/2, rnd.random()/5
        Ellipse:
            pos: self.width * 0.25, self.height * 0.5
            size: self.width * 0.14, self.height * 0.14
        Ellipse:
            pos: self.width * 0.61, self.height * 0.5
            size: self.width * 0.14, self.height * 0.14
        PopMatrix

        # 2. Wrapped horizontal instance
        PushMatrix
        Translate:
            xy: self.x - field_size()[0], self.y
        Rotate:
            angle: root.angle
            origin: self.width / 2, self.height / 2
        Color:
            rgb: root.color
        Triangle:
            points: (0, 0, self.width, 0, self.width / 2, self.height)
        Color:
            rgb: 0, 0, 0
        Ellipse:
            pos: self.width * 0.25, self.height * 0.5
            size: self.width * 0.14, self.height * 0.14
        Ellipse:
            pos: self.width * 0.61, self.height * 0.5
            size: self.width * 0.14, self.height * 0.14
        PopMatrix

        # 3. Wrapped vertical instance
        PushMatrix
        Translate:
            xy: self.x, self.y - field_size()[1]
        Rotate:
            angle: root.angle
            origin: self.width / 2, self.height / 2
        Color:
            rgb: root.color
        Triangle:
            points: (0, 0, self.width, 0, self.width / 2, self.height)
        Color:
            rgb: 0, 0, 0
        Ellipse:
            pos: self.width * 0.25, self.height * 0.5
            size: self.width * 0.14, self.height * 0.14
        Ellipse:
            pos: self.width * 0.61, self.height * 0.5
            size: self.width * 0.14, self.height * 0.14
        PopMatrix

    # Thin red line showing the snake head's obstacle/food collision margin.
    canvas.after:
        Color:
            rgba: 1, 0, 0, 1 if root.show_collision_margin else 0
        Line:
            width: UI_SCALE
            rectangle: self.x, self.y, self.width, self.height