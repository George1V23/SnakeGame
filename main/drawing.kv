#for assigning random color to the brush
#: import rnd random
#: import Window kivy.core.window.Window

# Drawing pad / Graphics creation
<Graphics>:
    canvas:
        Color:
            rgb: .2, .5, .5
        Rectangle:
            size: root.size
            pos: root.pos

# Paint brush coding
<PaintBrush>:
    size_hint: None, None
    size: 25, 50
    canvas:
        Color:
            rgb: rnd.random(), rnd.random(), rnd.random()
        Triangle:
            points:
                (self.x, self.y, self.x + self.width / 4, self.y,
                self.x + self.width / 4, self.y + self.height / 4)

# Square widget coding
<Square>:
    size_hint: None, None
    size: 20, 20
    canvas:
        Color:
            rgb: root.color
        Rectangle:
            size: self.size
            pos: self.x, self.y

    # Thin red line around the exact square edges used by collision logic.
    canvas.after:
        Color:
            rgba: 1, 0, 0, 1 if root.show_collision_margin else 0
        Line:
            width: 1
            rectangle: self.x, self.y, self.width, self.height

# Triangle widget coding
<Triangle>:
    angle: 0
    color: [rnd.random(), rnd.random(), rnd.random()]
    size_hint: None, None
    size: 30, 30
    canvas:
        # 1. Primary instance
        PushMatrix
        Translate:
            xy: self.x, self.y
        Rotate:
            angle: root.angle
            origin: self.width / 2, self.height / 2
        Color:
            rgb: root.color
        Triangle:
            points: (0, 0, self.width, 0, self.width / 2, self.height)
        Color:
            rgb: 1, rnd.random()/2, rnd.random()/5
        Ellipse:
            pos: self.width * 0.25, self.height * 0.5
            size: self.width * 0.14, self.height * 0.14
        Ellipse:
            pos: self.width * 0.61, self.height * 0.5
            size: self.width * 0.14, self.height * 0.14
        PopMatrix

        # 2. Wrapped horizontal instance
        PushMatrix
        Translate:
            xy: self.x - Window.width, self.y
        Rotate:
            angle: root.angle
            origin: self.width / 2, self.height / 2
        Color:
            rgb: root.color
        Triangle:
            points: (0, 0, self.width, 0, self.width / 2, self.height)
        Color:
            rgb: 0, 0, 0
        Ellipse:
            pos: self.width * 0.25, self.height * 0.5
            size: self.width * 0.14, self.height * 0.14
        Ellipse:
            pos: self.width * 0.61, self.height * 0.5
            size: self.width * 0.14, self.height * 0.14
        PopMatrix

        # 3. Wrapped vertical instance
        PushMatrix
        Translate:
            xy: self.x, self.y - Window.height
        Rotate:
            angle: root.angle
            origin: self.width / 2, self.height / 2
        Color:
            rgb: root.color
        Triangle:
            points: (0, 0, self.width, 0, self.width / 2, self.height)
        Color:
            rgb: 0, 0, 0
        Ellipse:
            pos: self.width * 0.25, self.height * 0.5
            size: self.width * 0.14, self.height * 0.14
        Ellipse:
            pos: self.width * 0.61, self.height * 0.5
            size: self.width * 0.14, self.height * 0.14
        PopMatrix

    # Thin red line showing the snake head's obstacle/food collision margin.
    canvas.after:
        Color:
            rgba: 1, 0, 0, 1 if root.show_collision_margin else 0
        Line:
            width: 1
            rectangle: self.x, self.y, self.width, self.height